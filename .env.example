# Copy to .env.local for development or configure the same values in Coolify.
# Never commit real credentials.

# Site analytics
NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX

# Claude-backed audit, demo and programmatic SEO
ANTHROPIC_API_KEY=your_anthropic_api_key
AUDIT_CLAUDE_MODEL=claude-opus-4-7
DEMO_CLAUDE_MODEL=claude-opus-4-7
SEO_GENERATION_SECRET=generate_a_long_random_value

# Email delivery and lead notifications
RESEND_API_KEY=your_resend_api_key
AUDIT_FROM_EMAIL=AIOS by Ayothedoc <audit@your_verified_domain>
HEALTHCARE_FROM_EMAIL=Ayothedoc <hello@your_verified_domain>
HEALTHCARE_ENQUIRY_EMAIL=your_monitored_healthcare_inbox
CAMPAIGN_FROM_EMAIL=Ayothedoc <updates@your_verified_domain>
AUDIT_SLACK_WEBHOOK_URL=

# Optional calendar links shown only after a successful form submission
AIOS_BOOKING_URL=
HEALTHCARE_BOOKING_URL=

# AIOS Lead Engine handoff
LEAD_ENGINE_URL=https://your_lead_engine_endpoint
LEAD_ENGINE_SECRET=generate_a_long_random_value

# Contact and audit abuse controls
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# PostgreSQL, configure DATABASE_URL or POSTGRES_URL
DATABASE_URL=postgresql://user:password@host:5432/database
POSTGRES_URL=
POSTGRES_SSL=true

# Optional Airtable fallback for audit leads
AIRTABLE_API_KEY=
AIRTABLE_BASE_ID=
AIRTABLE_TABLE_NAME=Audit Leads

# Admin secret store and lead API
SECRETS_ENCRYPTION_KEY=generate_32_bytes_as_64_hex_characters
LEADS_API_KEY=generate_a_long_random_value

# AIOS database-backed blog subscription form
NEXT_PUBLIC_EMAILJS_SERVICE_ID=
NEXT_PUBLIC_EMAILJS_TEMPLATE_ID=
NEXT_PUBLIC_EMAILJS_PUBLIC_KEY=

# GitHub OAuth used by the repository's CMS/admin integration
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# Coolify Docker build
DOCKER_BUILD=true
